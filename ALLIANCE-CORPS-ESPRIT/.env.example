# URL publique du site (metadata Open Graph, robots.txt, sitemap.xml)
# Recette (par défaut) : https://alliance.s-fservices.fr — non indexée par Google
# Production (plus tard, domaine de la cliente) : https://www.alliancecorpsesprit.fr
NEXT_PUBLIC_SITE_URL=https://alliance.s-fservices.fr

# Domaines servis par Caddy (labels caddy-docker-proxy), séparés par une virgule
CADDY_DOMAINS=alliance.s-fservices.fr

# Formulaire de contact : envoi des messages par e-mail via Resend (https://resend.com), comme observebyte.fr
# Sans RESEND_API_KEY ni CONTACT_TO_EMAIL, le formulaire affiche le téléphone à la place.
RESEND_API_KEY=
# Adresse qui reçoit les messages (celle de la praticienne)
CONTACT_TO_EMAIL=
# Expéditeur : adresse d'un domaine vérifié sur Resend (ex. Alliance Corps Esprit <contact@s-fservices.fr>)
CONTACT_FROM_EMAIL=

# URL publique du site (metadata, Open Graph, robots.txt, sitemap.xml)
# Provisoire pendant la validation, à remplacer par le vrai domaine à la migration.
NEXT_PUBLIC_SITE_URL=https://s-fservices.fr

# Domaine utilisé par Caddy (label docker-compose) pour router vers ce conteneur.
SITE_DOMAIN=s-fservices.fr

# Passer à "true" uniquement sur le domaine définitif, une fois le site validé
# par la cliente et prêt à être indexé par les moteurs de recherche.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Protection par mot de passe du site pendant la phase de validation.
# Laisser vide pour désactiver (ne pas faire avant la mise en ligne définitive).
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Envoi du formulaire de contact via SMTP (boîte mail OVH de la cliente).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# URL publique du site (pour les metadata OG, robots.txt, sitemap.xml)
NEXT_PUBLIC_SITE_URL=https://observebyte.fr

# Envoi du formulaire de contact via Resend (https://resend.com)
# 1. Créer un compte Resend, vérifier un domaine (ou utiliser onboarding@resend.dev en test)
# 2. Générer une clé API et la coller ci-dessous
RESEND_API_KEY=

# Adresse qui reçoit les messages du formulaire
CONTACT_TO_EMAIL=ramy.mahdjoubi@gmail.com

# Adresse d'expédition — doit appartenir à un domaine vérifié sur Resend en production
CONTACT_FROM_EMAIL=ObserveByte <contact@observebyte.fr>

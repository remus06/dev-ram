# URL publique du site (metadata, robots.txt, sitemap.xml).
# Recette : https://alliance.s-fservices.fr  → le site est automatiquement exclu de Google.
# Production : https://www.alliancecorpsesprit.fr
NEXT_PUBLIC_SITE_URL=https://www.alliancecorpsesprit.fr

# Domaines servis par Caddy (docker-compose sans Coolify)
SITE_DOMAINS=alliancecorpsesprit.fr, www.alliancecorpsesprit.fr

# Formulaire de contact via Resend (https://resend.com) — domaine d'envoi à vérifier sur Resend
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Alliance Corps Esprit <contact@alliancecorpsesprit.fr>

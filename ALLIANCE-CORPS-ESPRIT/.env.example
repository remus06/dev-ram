# URL publique du site (metadata Open Graph, robots.txt, sitemap.xml)
# Recette (par défaut) : https://alliance.s-fservices.fr — non indexée par Google
# Production (plus tard, domaine de la cliente) : https://www.alliancecorpsesprit.fr
NEXT_PUBLIC_SITE_URL=https://alliance.s-fservices.fr

# Domaines servis par Caddy (labels caddy-docker-proxy), séparés par une virgule
CADDY_DOMAINS=alliance.s-fservices.fr
